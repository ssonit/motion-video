# dependencies / build
node_modules/
studio/node_modules/
studio/out/
studio/.remotion/

# temp and scratch (render temp files, preview frames)
.tmp/
output/_preview/

# finished and downloaded videos (large; keep locally, share via SendUserFile)
output/*.mp4
*.mp4
*.mov
*.mkv
*.webm

# cloned third-party repos (idea sources only)
references/_external/

# OS / editor
.DS_Store
Thumbs.db
*.log
.env
.env.*

!output/.gitkeep

# older experiments, kept locally only
archive/

# audio extracted from references (large)
references/**/*.wav

# rea-video venv + models (local tooling)
.venv-rea/
.rea-models/
references/*/rea/

# user's own footage: raw files and sheets stay local, the catalogue is tracked
footage/**
!footage/*/
!footage/*/clips.json
!footage/*/clips.md

# browser tool logs, yt-dlp metadata dumps (~11 MB each)
.playwright-mcp/
references/*/source.info.json
